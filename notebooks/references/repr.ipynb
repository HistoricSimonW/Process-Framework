   "source": [
    "from process_framework.composition.mixins.repr import HasRepr\n",
    "\n",
    "class ListWithRepr(HasRepr):\n",
    "    values = list()\n",
    "\n",
    "    def _get_repr_value(self):\n",
    "        return self.values\n",
    "    \n",
    "    def __init__(self, *vs):\n",
    "        self.values = list(vs)\n",
    "\n",
    "\n",
    "ListWithRepr('a', 1, '2', *list(range(20)))"
   ]
  }
 ],
